rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member(shopId) { return request.auth != null && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid)); }
  match /shops/{shopId}/{document=**} { allow read, write: if member(shopId); }
  match /shops/{shopId}/members/{uid} { allow read: if request.auth != null && request.auth.uid==uid; allow write: if false; }
  match /stock/{docId} { allow read, write: if request.auth != null; }
  match /products/{docId} { allow read, write: if request.auth != null; }
  match /batches/{docId} { allow read, write: if request.auth != null; }
  match /bills/{docId} { allow read, write: if request.auth != null; }
  match /purchases/{docId} { allow read, write: if request.auth != null; }
  match /suppliers/{docId} { allow read, write: if request.auth != null; }
  match /customers/{docId} { allow read, write: if request.auth != null; }
  match /reminders/{docId} { allow read, write: if request.auth != null; }
  match /orders/{docId} { allow read, write: if request.auth != null; }
  match /stockMovements/{docId} { allow read, write: if request.auth != null; }
  match /h_register/{docId} { allow read, write: if request.auth != null; }
  match /meta/{docId} { allow read, write: if request.auth != null; }
  match /staff/{docId} { allow read, write: if request.auth != null; }
 }
}
